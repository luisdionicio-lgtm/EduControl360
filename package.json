{
  "name": "educontrol360",
  "private": true,
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=22.20.0 <23"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @edu/web --filter @edu/api dev",
    "build": "pnpm --filter @edu/database build && pnpm --filter @edu/api build && pnpm --filter @edu/web build",
    "typecheck": "pnpm --filter @edu/database build && pnpm -r typecheck",
    "test": "pnpm --filter @edu/api test",
    "db:generate": "pnpm --filter @edu/database generate",
    "db:migrate": "pnpm --filter @edu/database migrate",
    "infra:up": "docker compose up -d postgres redis",
    "infra:down": "docker compose down",
    "verify": "pnpm db:generate && pnpm typecheck && pnpm test && pnpm build",
    "test:e2e": "node --env-file-if-exists=.env scripts/test-e2e.cjs",
    "format:check": "prettier --check apps packages scripts tests *.json *.yml *.yaml .github"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.0.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3"
  }
}
